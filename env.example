# WhereWeGo 환경 변수 설정 예제
# 이 파일을 .env로 복사하고 실제 값으로 수정하세요

# ===== MongoDB 설정 =====
# MongoDB Atlas 클라우드 연결 (우선순위 1)
MONGO_ATLAS_URL=mongodb+srv://username:password@cluster.mongodb.net/tourism_recommendation

# 로컬 MongoDB 설정 (Atlas가 없을 때 사용)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=
MONGO_PASS=
MONGO_DB=tourism_recommendation

# MongoDB 연결 타임아웃 설정 (밀리초)
MONGO_SERVER_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=30000

# ===== API 키 설정 =====
# Kakao API (지도 서비스용)
KAKAO_API_KEY=your_kakao_api_key_here

# ===== 모델 설정 =====
# 학습 모드 (development/production)
ENVIRONMENT=development

# GPU 사용 여부
USE_CUDA=auto

# 모델 체크포인트 저장 경로
MODEL_SAVE_PATH=./checkpoints

# ===== 로깅 설정 =====
LOG_LEVEL=INFO
LOG_FILE=./logs/wherewego.log

# ===== 보안 설정 =====
# JWT 시크릿 키 (사용자 인증용)
JWT_SECRET_KEY=your_jwt_secret_key_here

# 암호화 키
ENCRYPTION_KEY=your_encryption_key_here 